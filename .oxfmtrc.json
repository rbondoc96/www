{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": ["**/.output", "**/.tanstack", "**/build", "**/dist", "**/out", "**/meta", "**/routeTree.gen.ts"],
  "singleQuote": false,
  "jsxSingleQuote": false,
  "printWidth": 120,
  "quoteProps": "consistent",
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,

  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "functions": ["cva", "clsx", "cn"],
    "stylesheet": "./apps/web/src/styles/globals.css"
  }
}
